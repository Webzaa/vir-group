{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@AllSection/*": ["./src/All Section/*"],
      "@media/*": ["./public/media/*"],
      "@public/*": ["./public/*"]
    }
  },
  "include": ["src", "server", "scripts", "vite.config.js"]
}
